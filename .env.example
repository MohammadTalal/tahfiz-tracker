# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL. Local: printed by `npm run db:start` (usually http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (starts with sb_publishable_). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Not used in the pilot. Never prefix a secret key with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
